# El token de GitHub YA NO va aquí: es un secreto de Supabase (GITHUB_TOKEN) que usa
# la Edge Function github-proxy. Ver README → "Token de GitHub".

# Supabase: Project Settings → API.
# Solo la clave PUBLISHABLE (sb_publishable_...) puede ir al navegador; la protegen las políticas RLS.
# NUNCA pongas aquí la clave secreta (sb_secret_...) ni la service_role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

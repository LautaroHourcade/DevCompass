# Token personal de GitHub (opcional). Sin él la API permite 60 peticiones/hora.
# Crea uno en https://github.com/settings/tokens (no necesita permisos).
# NO uses el prefijo VITE_: así el token nunca llega al código del navegador.
GITHUB_TOKEN=

# Supabase: Project Settings → API.
# Solo la clave PUBLISHABLE (sb_publishable_...) puede ir al navegador; la protegen las políticas RLS.
# NUNCA pongas aquí la clave secreta (sb_secret_...) ni la service_role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
